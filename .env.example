# VITE_USE_POLLING: Enable polling-based file watching for Docker bind mounts.
# Set to true when live reload does not detect file changes from the host machine.
VITE_USE_POLLING="false"

# PORT: Docker production host port.
PORT="3000"

# DEV_PORT: Host port for the Docker Compose development service.
DEV_PORT="3001"

# APP_URL: Canonical public origin used for CORS, robots, and sitemap URLs.
APP_URL="https://findadrop.org"

# CORS_ORIGIN: Comma-separated list of allowed browser origins for cross-origin API calls.
# Leave empty for same-origin production use. Development allows localhost when empty.
CORS_ORIGIN=""

# LANCEDB_PATH: Docker Compose sets this inside containers to /data/lancedb,
# backed by a host directory. Leave unset in .env for the standard Docker workflow.
LANCEDB_PATH=""

# COMMUNITY_MEDIA_PATH: Docker Compose stores processed community story images
# under /data/media/community, backed by data/media(-dev) on the host.
COMMUNITY_MEDIA_PATH=""

# Leave SMS_PROVIDER blank to print OTPs to the server console outside
# production. For Woven, set it to "woven", keep the installation base URL
# configurable here, and provide a server-side API key with messages:send.
# Woven queues every message for signed-in approval before the phone sends it.
# The legacy provider-neutral "http" option still uses SMS_HTTP_ENDPOINT and
# SMS_HTTP_TOKEN. Any incomplete explicit configuration fails closed.
SMS_PROVIDER=""
SMS_API_BASE_URL="https://woven.137.184.10.222.nip.io"
SMS_API_TOKEN=""
SMS_HTTP_ENDPOINT=""
SMS_HTTP_TOKEN=""

# Safety policy defaults; change only after operational/clinical review.
DONATION_INTERVAL_DAYS="120"
AVAILABILITY_TTL_DAYS="14"
MATCH_RADIUS_KM="250"

# ADMIN_PHONE: verified account promoted to superadmin at server startup.
ADMIN_PHONE=""
