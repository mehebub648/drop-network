# VITE_USE_POLLING: Enable polling-based file watching for Docker bind mounts.
# Set to true when live reload does not detect file changes from the host machine.
VITE_USE_POLLING="false"

# DEV_PORT: Host port for the Docker Compose development service.
DEV_PORT="3000"

# PROD_PORT: Host port for the Docker Compose production service.
PROD_PORT="3001"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
