# VITE_USE_POLLING: Enable polling-based file watching for Docker bind mounts.
# Set to true when live reload does not detect file changes from the host machine.
VITE_USE_POLLING="false"

# PORT: App server port for direct local runs and the Docker production host port.
PORT="3000"

# DEV_PORT: Host port for the Docker Compose development service.
DEV_PORT="3001"

# PROD_PORT: Optional fallback app server port for direct production-style runs.
PROD_PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CORS_ORIGIN: Comma-separated list of allowed browser origins for cross-origin API calls.
# Leave empty for same-origin production use. Development allows localhost when empty.
CORS_ORIGIN=""

# SEED_DEMO_DATA: Set true only for local demos that need generated donors/requests.
SEED_DEMO_DATA="false"

# DEMO_SEED_PASSWORD: Optional password for locally seeded demo donors.
# Leave empty to generate unique random demo passwords.
DEMO_SEED_PASSWORD=""
